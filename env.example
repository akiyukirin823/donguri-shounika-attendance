# ===== App =====
NODE_ENV=production
APP_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET

# ===== PostgreSQL =====
# RailwayのPostgresサービスからDATABASE_URLを参照設定してください。
DATABASE_URL=

# ===== LINE LIFF =====
# LINE Login channelのChannel ID
LINE_CHANNEL_ID=
# LIFF Server API用のChannel Access Token
# チャットに貼らず、Railway Variablesへ直接登録してください。
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF IDは setup:line 後に設定
LINE_LIFF_ID=

# ===== App settings =====
CLINIC_NAME=どんぐり小児科
LIFF_NAME=どんぐり小児科 出退勤
LIFF_VIEW_TYPE=full
